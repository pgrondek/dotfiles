// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "ipc": false,
    "reload_style_on_change": true,
    "height": 30,
    "modules-left": [
        "mango/workspaces",
        "mango/layout",
        "mango/window"
    ],
    "modules-center": [
    ],
    "modules-right": [
        "idle_inhibitor",
        "network#wg",
        "network",
        "pulseaudio",
        "pulseaudio#microphone",
        "cpu",
        "memory",
        "temperature",
        "keyboard-state",
        "battery",
        "backlight",
        "tray",
        "clock",
        "custom/power"
    ],
    // Modules configuration
    "mango/workspaces": {
        "hide-empty": true
    },
    "mango/layout": {
        "format": "{}",
        "format-S": "Scr",
        "format-T": "Tile",
        "format-M": "Mono",
        "format-F": "Flt"
    },
    "mango/window": {
        "format": "{title}"
    },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "cpu": {
        "format": " {usage}% ",
        "tooltip": false
    },
    "temperature": {
        "thermal-zone": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": [
            "",
            "",
            ""
        ]
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["\uD83D\uDD05", "\uD83D\uDD06"],
        "on-scroll-up": "brightnessctl set +1%",
        "on-scroll-down": "brightnessctl set 1%-",
        "smooth-scrolling-threshold": 1
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        "interval": 1,
        "spacing": 10
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}",
        "on-click-right": "gsimplecal"
    },
    "memory": {
        "format": " {}%"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-warning": "<span color='#ffcc66'>{icon} {capacity}%</span>",
        "format-critical": "<span color='#ff6699'>{icon} {capacity}%</span>",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "tooltip-format": "IF: {ifname}\nIP: {ipaddr}/{cidr}\nGW: {gwaddr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\nIF: {ifname}\nIP: {ipaddr}/{cidr}\nGW: {gwaddr}",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "on-click-right": "nm-connection-editor"
    },
    "network#wg": {
        "interface": "wg0",
        "format": "",
        "format-disconnected": "<span color='#ff6699'></span>",
        "tooltip-format": "IP: {ipaddr}/{cidr}",
        "on-click-right": "toggle-wg"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-bluetooth": "{icon} {volume}%  ",
        "format-bluetooth-muted": " Mute ",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pamixer -t"
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "<span color='#ff6699'> {volume}%</span>",
        "tooltip": false,
        "format-source-muted": "",
        "on-click": "pamixer --default-source -t",
        "on-scroll-up": "pamixer --default-source -i 2",
        "on-scroll-down": "pamixer --default-source -d 2",
        "on-click-right": "pamixer --default-source -t",
        "scroll-step": 5
    },
    "custom/power": {
        "format" : "⏻",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
		"menu-actions": {
			"shutdown": "shutdown",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
    }
}
